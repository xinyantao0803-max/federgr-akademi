# 访问控制模块环境变量
NODE_ENV=development

# 服务配置
AC_SERVICE_PORT=3003
AC_SERVICE_HOST=0.0.0.0

# 认证服务地址 (使用认证服务的 JWT)
AUTH_SERVICE_URL=http://localhost:3001

# 数据库配置 (示例，实际应使用真实数据库)
DATABASE_URL=mysql://user:password@localhost:3306/federgr_access_control
MONGODB_URL=mongodb://localhost:27017/federgr_logs

# 硬件配置
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# 日志级别
LOG_LEVEL=info

# 心跳配置
HEARTBEAT_INTERVAL=30000
HEARTBEAT_TIMEOUT=5000
