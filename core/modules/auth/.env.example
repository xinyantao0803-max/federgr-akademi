# FederGR Auth Module Configuration
# 复制此文件为 .env 并填入实际值

# 应用环境
NODE_ENV=development
PORT=3001

# JWT 配置
JWT_SECRET=change-me-in-production-with-a-strong-secret-key
ACCESS_TOKEN_EXPIRY=30m
REFRESH_TOKEN_EXPIRY=7d

# Bcrypt 配置
BCRYPT_SALT_ROUNDS=10

# 数据库配置（未来的生产环境）
# DATABASE_URL=postgresql://user:password@localhost:5432/federgr
# MONGODB_URL=mongodb://localhost:27017/federgr

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json

# 跨域配置
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# API 密钥（用于服务间通信）
API_KEY=your-api-key-for-service-communication

# 2FA 配置（未来的生产环境）
# TWILIO_AUTH_TOKEN=your-twilio-token
# SENDGRID_API_KEY=your-sendgrid-key

# Redis 配置（会话存储）
# REDIS_URL=redis://localhost:6379

# 审计日志
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555
