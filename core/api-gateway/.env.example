# API 网关环境变量
NODE_ENV=development

# 网关配置
GATEWAY_PORT=8000
GATEWAY_HOST=0.0.0.0
GATEWAY_TIMEOUT=30000

# 日志配置
LOG_LEVEL=info

# CORS 配置
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# 速率限制（每分钟最多请求数）
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=1000

# 后端服务地址
AUTH_SERVICE_HOST=auth
AUTH_SERVICE_PORT=3001

EDU_SERVICE_HOST=edu
EDU_SERVICE_PORT=3002

ACCESS_CONTROL_SERVICE_HOST=access-control
ACCESS_CONTROL_SERVICE_PORT=3003

PAYMENT_SERVICE_HOST=payment
PAYMENT_SERVICE_PORT=3004

IOT_SERVICE_HOST=iot
IOT_SERVICE_PORT=3005

BROADCAST_SERVICE_HOST=broadcast
BROADCAST_SERVICE_PORT=3006

# 健康检查配置
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
